{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namingPrefix": {
      "type": "string",
      "metadata": { "description": "Short prefix for all resource names, e.g. 'gp'." }
    },
    "team": {
      "type": "string",
      "metadata": { "description": "Team slug injected into resource names, e.g. 'platform'." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for all resources." }
    },
    "environment": {
      "type": "string",
      "allowedValues": ["dev", "staging", "prod"],
      "metadata": { "description": "Deployment environment." }
    },
    "aksNodeCount": {
      "type": "int",
      "defaultValue": 3,
      "minValue": 1,
      "maxValue": 100,
      "metadata": { "description": "Initial node count for the AKS system node pool." }
    },
    "aksNodeVmSize": {
      "type": "string",
      "defaultValue": "Standard_D4s_v5",
      "metadata": { "description": "VM size for AKS agent nodes." }
    },
    "logAnalyticsRetentionDays": {
      "type": "int",
      "defaultValue": 30,
      "metadata": { "description": "Log Analytics workspace retention in days." }
    }
  },
  "variables": {
    "aksName": "[concat(parameters('namingPrefix'), '-', parameters('team'), '-', parameters('location'), '-aks')]",
    "acrName": "[concat(parameters('namingPrefix'), parameters('team'), replace(parameters('location'), '-', ''), 'acr')]",
    "kvName": "[concat(parameters('namingPrefix'), '-', parameters('team'), '-', parameters('location'), '-kv')]",
    "laName": "[concat(parameters('namingPrefix'), '-', parameters('team'), '-', parameters('location'), '-la')]",
    "defaultTags": {
      "Team": "[parameters('team')]",
      "Environment": "[parameters('environment')]",
      "ManagedBy": "golden-path-provisioner"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('laName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('defaultTags')]",
      "properties": {
        "sku": { "name": "PerGB2018" },
        "retentionInDays": "[parameters('logAnalyticsRetentionDays')]",
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-02-01",
      "name": "[variables('kvName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('defaultTags')]",
      "properties": {
        "sku": { "family": "A", "name": "standard" },
        "tenantId": "[subscription().tenantId]",
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 90,
        "enablePurgeProtection": true,
        "enableRbacAuthorization": true,
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Deny"
        }
      }
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-01-01-preview",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('defaultTags')]",
      "sku": { "name": "Premium" },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Disabled",
        "zoneRedundancy": "Enabled"
      }
    },
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2024-02-01",
      "name": "[variables('aksName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('defaultTags')]",
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "dnsPrefix": "[variables('aksName')]",
        "agentPoolProfiles": [
          {
            "name": "system",
            "count": "[parameters('aksNodeCount')]",
            "vmSize": "[parameters('aksNodeVmSize')]",
            "mode": "System",
            "availabilityZones": ["1", "2", "3"],
            "enableAutoScaling": true,
            "minCount": 1,
            "maxCount": 10,
            "osDiskType": "Ephemeral"
          }
        ],
        "networkProfile": {
          "networkPlugin": "azure",
          "networkPolicy": "azure",
          "loadBalancerSku": "standard",
          "outboundType": "loadBalancer"
        },
        "addonProfiles": {
          "omsagent": {
            "enabled": true,
            "config": {
              "logAnalyticsWorkspaceResourceID": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('laName'))]"
            }
          }
        },
        "enableRBAC": true,
        "aadProfile": {
          "managed": true,
          "enableAzureRBAC": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('laName'))]"
      ]
    }
  ],
  "outputs": {
    "aksName": { "type": "string", "value": "[variables('aksName')]" },
    "acrName": { "type": "string", "value": "[variables('acrName')]" },
    "kvName": { "type": "string", "value": "[variables('kvName')]" },
    "laName": { "type": "string", "value": "[variables('laName')]" }
  }
}
