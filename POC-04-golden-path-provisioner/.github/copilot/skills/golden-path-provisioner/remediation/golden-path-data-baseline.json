{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namingPrefix": {
      "type": "string",
      "metadata": { "description": "Short prefix for all resource names, e.g. 'gp'." }
    },
    "team": {
      "type": "string",
      "metadata": { "description": "Team slug injected into resource names, e.g. 'analytics'." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region for all resources." }
    },
    "environment": {
      "type": "string",
      "allowedValues": ["dev", "staging", "prod"],
      "metadata": { "description": "Deployment environment." }
    },
    "storageSkuName": {
      "type": "string",
      "defaultValue": "Standard_ZRS",
      "allowedValues": ["Standard_ZRS", "Standard_GZRS", "Standard_GRS"],
      "metadata": { "description": "Storage account replication SKU. ZRS minimum for golden path." }
    }
  },
  "variables": {
    "storageName": "[concat(replace(parameters('namingPrefix'), '-', ''), parameters('team'), replace(parameters('location'), '-', ''), 'st')]",
    "adfName": "[concat(parameters('namingPrefix'), '-', parameters('team'), '-', parameters('location'), '-adf')]",
    "kvName": "[concat(parameters('namingPrefix'), '-', parameters('team'), '-', parameters('location'), '-kv')]",
    "defaultTags": {
      "Team": "[parameters('team')]",
      "Environment": "[parameters('environment')]",
      "ManagedBy": "golden-path-provisioner"
    }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-02-01",
      "name": "[variables('kvName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('defaultTags')]",
      "properties": {
        "sku": { "family": "A", "name": "standard" },
        "tenantId": "[subscription().tenantId]",
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 90,
        "enablePurgeProtection": true,
        "enableRbacAuthorization": true,
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Deny"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('defaultTags')]",
      "sku": { "name": "[parameters('storageSkuName')]" },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "supportsHttpsTrafficOnly": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "networkAcls": {
          "bypass": "AzureServices",
          "defaultAction": "Deny"
        }
      }
    },
    {
      "type": "Microsoft.DataFactory/factories",
      "apiVersion": "2018-06-01",
      "name": "[variables('adfName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('defaultTags')]",
      "identity": { "type": "SystemAssigned" },
      "properties": {
        "publicNetworkAccess": "Disabled"
      }
    }
  ],
  "outputs": {
    "storageName": { "type": "string", "value": "[variables('storageName')]" },
    "adfName": { "type": "string", "value": "[variables('adfName')]" },
    "kvName": { "type": "string", "value": "[variables('kvName')]" }
  }
}
