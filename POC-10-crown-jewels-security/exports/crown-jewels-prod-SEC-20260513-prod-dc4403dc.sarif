          "informationUri": "https://github.com/your-org/arm-mcp/tree/main/POC-10-crown-jewels-security",
          "rules": [
            {
              "id": "R001",
              "name": "InternetExposedResourcesWithManagedIdentities",
              "shortDescription": {
                "text": "Internet-exposed resources with managed identities"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critical",
                "weight": 15,
                "category": "identity-exposure"
              }
            },
            {
              "id": "R002",
              "name": "ResourcesWithOwnerContributorRoleAssignments",
              "shortDescription": {
                "text": "Resources with Owner or Contributor role assignments"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "high",
                "weight": 12,
                "category": "broad-rbac",
                "skip_if_unavailable": true
              }
            },
            {
              "id": "R003",
              "name": "KeyVaultsWithBroadNetworkAccess",
              "shortDescription": {
                "text": "Key Vaults with broad network access (Allow from All Networks)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "high",
                "weight": 10,
                "category": "key-vault-exposure"
              }
            },
            {
              "id": "R004",
              "name": "PublicFacingResourcesWithPublicIpAddresses",
              "shortDescription": {
                "text": "Public-facing resources with assigned public IP addresses"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "severity": "medium",
                "weight": 8,
                "category": "public-exposure"
              }
            },
            {
              "id": "R005",
              "name": "ResourcesWithMultipleHighPrivilegeRoleAssignments",
              "shortDescription": {
                "text": "Resources with multiple high-privilege role assignments"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "severity": "critical",
                "weight": 14,
                "category": "broad-rbac",
                "skip_if_unavailable": true
              }
            }
          ]
        }
      },
