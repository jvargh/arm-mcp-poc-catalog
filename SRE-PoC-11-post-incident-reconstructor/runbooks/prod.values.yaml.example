# Example values file — copy to `prod.values.yaml` and edit.
# `prod.values.yaml` is gitignored; this `.example` is committed so others
# know the schema.

subscription_id: "<your-subscription-guid-here>"

# Incident time window in UTC ISO 8601 format.
incident_start_utc: "2026-01-01T00:00:00Z"
incident_end_utc:   "2026-01-01T02:00:00Z"

# Scope: "subscription" or "resourceGroup"
incident_scope: "resourceGroup"

rg_include:
  - "<rg-name-1>"
  - "<rg-name-2>"

rg_exclude: []

# Postmortem template format: "standard" (default)
postmortem_template_format: "standard"
