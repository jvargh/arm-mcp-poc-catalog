{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sample ARM template for the Blast-Radius Simulator PoC. Intentionally touches all five impact categories (R001 DNS endpoint, R002 identity rotation, R003 cert regen, R004 RBAC, R005 dependency edge) so the simulator produces a non-trivial risk score."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "appName": {
      "type": "string",
      "defaultValue": "blastradius-demo-app"
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "blastradius-demo-vnet"
    },
    "kvName": {
      "type": "string",
      "defaultValue": "blastradius-demo-kv"
    },
    "uamiName": {
      "type": "string",
      "defaultValue": "blastradius-demo-uami"
    },
    "readerPrincipalId": {
      "type": "string",
      "defaultValue": "00000000-0000-0000-0000-000000000000",
      "metadata": {
        "description": "Object ID of the principal to receive Reader on the resource group. Replace before deploy."
      }
    }
  },
  "variables": {
    "planName": "[concat(parameters('appName'), '-plan')]",
    "readerRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]",
    "roleAssignmentName": "[guid(resourceGroup().id, parameters('readerPrincipalId'), variables('readerRoleId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('uamiName')]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": { "addressPrefixes": [ "10.42.0.0/16" ] },
        "subnets": [
          {
            "name": "app-subnet",
            "properties": { "addressPrefix": "10.42.1.0/24" }
          }
        ]
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('kvName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": { "family": "A", "name": "standard" },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "P1v3", "tier": "PremiumV3" },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('uamiName'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('uamiName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', parameters('kvName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[variables('roleAssignmentName')]",
      "properties": {
        "roleDefinitionId": "[variables('readerRoleId')]",
        "principalId": "[parameters('readerPrincipalId')]",
        "principalType": "User"
      }
    }
  ],
  "outputs": {
    "appHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName'))).defaultHostName]"
    }
  }
}
