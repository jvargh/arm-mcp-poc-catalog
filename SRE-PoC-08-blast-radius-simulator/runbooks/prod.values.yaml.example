# Example values file — copy to `prod.values.yaml` and edit.
# `prod.values.yaml` is gitignored; this `.example` is committed so others
# know the schema.

subscription_id: "<your-subscription-guid-here>"

# Path to the ARM template JSON file to simulate (relative to workspace root).
# Example: "templates/my-app-template.json"
template_path: "<path-to-arm-template.json>"
