# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Local runbook values (real subscription IDs / RG names).
# Commit only the *.yaml templates and *.yaml.example sibling.
**/runbooks/*.values.yaml
